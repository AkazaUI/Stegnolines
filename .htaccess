# ══════════════════════════════════════════════════════════════
# STEGNOLINES PRODUCTION SERVER CONFIGURATION (.htaccess)
# Optimized for Hostinger / LiteSpeed / Apache Web Server
# ══════════════════════════════════════════════════════════════

# ── 1. REWRITE ENGINE & ROUTING ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical / Legacy 301 Redirects
  RewriteRule ^about%20us(\.html)?$ /about [R=301,L]
  RewriteRule ^contact%20team(\.html)?$ /contact [R=301,L]
  RewriteRule ^details(\.html)?$ / [R=301,L]

  # Clean URLs: Serve .html transparently without showing extension
  # If requested URL exists as an actual file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If requested URL + .html exists, rewrite internally
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ── 2. MIME TYPES ──
<IfModule mod_mime.c>
  AddType font/woff2                          .woff2
  AddType font/ttf                            .ttf
  AddType image/avif                          .avif
  AddType image/webp                          .webp
  AddType application/manifest+json           .webmanifest
  AddType application/wasm                    .wasm
  AddType text/markdown                       .md
</IfModule>

# ── 3. GZIP / DEFLATE COMPRESSION (mod_deflate) ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/opentype
</IfModule>

# ── 4. BROWSER EXPIRES & CACHING (mod_expires) ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML pages (revalidate for fresh updates)
  ExpiresByType text/html "access plus 0 seconds"

  # Immutable Fonts (1 year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Images & Media (1 year)
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Stylesheets & Scripts (1 year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Web Manifest
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# ── 5. HTTP CACHE-CONTROL & SECURITY HEADERS (mod_headers) ──
<IfModule mod_headers.c>
  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Tight Content Security Policy (allows local assets + trusted CDNs)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self';"

  # Cache-Control: Static Assets (Fonts, WebP, AVIF, PNG, SVG)
  <FilesMatch "\.(woff2|ttf|woff|eot|otf|avif|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache-Control: CSS and JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Cache-Control: HTML documents
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Cache-Control: Service Worker & Web Manifest (Must never be stale)
  <FilesMatch "(sw\.js|site\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
